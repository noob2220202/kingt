# 복사해서 체크아웃 루트에 .env.production 으로 저장:
#   cp deploy/no1.ticketking.store/env.production.example .env.production
# 값 바꾼 뒤에는 반드시 다시 build 해야 반영됨 (npm run build && pm2 restart ticketking-no1)

NEXT_PUBLIC_SITE_NAME=킹상품권

# 관리자 세션 서명 키 — 아래 명령으로 생성해서 붙여넣기
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

BUSINESS_COMPANY_NAME=킹상품권
BUSINESS_CEO_NAME=정무성
BUSINESS_CS_PHONE=010-2245-1756

# 정무성 대표 본인 명의의 사업자 정보를 넣으세요.
# 빈 값으로 두면 푸터/회사소개에서 해당 항목이 숨겨집니다.
# (비워두지 않고 이 줄을 지우면 1번 사이트의 사업자번호·주소가 그대로 노출되니 지우지 마세요)
BUSINESS_REG_NO=
BUSINESS_ADDRESS=
BUSINESS_MAIL_ORDER_REG_NO=
BUSINESS_CS_EMAIL=
BUSINESS_FOUNDED_YEAR=2024
