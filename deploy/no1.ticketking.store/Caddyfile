# no1.ticketking.store → Next.js (pm2, 127.0.0.1:3001)
# Caddy가 Let's Encrypt 인증서를 자동 발급/갱신합니다.
# DNS A 레코드(no1.ticketking.store → 119.205.221.171)가 먼저 잡혀 있어야 합니다.

no1.ticketking.store {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3001

	log {
		output file /var/log/caddy/no1.ticketking.store.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# www로 들어오면 본 도메인으로 보냄 (www DNS를 안 잡을 거면 이 블록은 지워도 됨)
www.no1.ticketking.store {
	redir https://no1.ticketking.store{uri} permanent
}
